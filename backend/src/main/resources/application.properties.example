spring.application.name=placement-ai-assistant-backend
spring.profiles.active=dev

# Database Configuration (PostgreSQL)
# Copy this file to application-dev.properties or set environment variables:
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
spring.datasource.url=jdbc:postgresql://localhost:5432/placement_ai
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:postgres}

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# JWT Secret Configuration
# By default, a 256-bit secret is generated or set via JWT_SECRET
application.security.jwt.secret-key=${JWT_SECRET:404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970}
application.security.jwt.expiration=86400000
